{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sauces plan (.sauces/plan.json)",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "approved": {
      "type": "boolean"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "user",
        "eval",
        null
      ]
    },
    "platform": {
      "type": "string",
      "enum": [
        "flutter",
        "ios-swiftui",
        "android-compose",
        "kmp-cmp",
        "react-native",
        "web-react",
        "web-html"
      ]
    },
    "project_root": {
      "type": "string",
      "pattern": "^.+$",
      "description": "Exact root from the selected project-profile entry, relative to the target root."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "design_ref": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": [
              "reuse",
              "extend",
              "new",
              "token"
            ]
          },
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "level": {
            "type": "string",
            "enum": [
              "token",
              "atom",
              "molecule",
              "organism",
              "screen"
            ]
          },
          "existing_path": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "update": {
            "type": "string",
            "enum": [
              "unchanged"
            ]
          },
          "affects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "design_ref",
          "decision",
          "name",
          "path",
          "level",
          "confidence"
        ]
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "finding_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "changes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "label"
              ]
            }
          },
          "choice": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "finding_id",
          "title",
          "why",
          "options",
          "choice"
        ]
      }
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "screen": {
            "type": "string"
          },
          "existing": {
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "value",
          "screen"
        ]
      }
    },
    "dependency_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "package": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "dev",
              "main"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "package",
          "version",
          "scope",
          "reason"
        ]
      }
    },
    "structure": {
      "type": "object",
      "properties": {
        "recommended": {
          "type": "string",
          "enum": [
            "atomic",
            "layered",
            "feature-first",
            "follow"
          ]
        },
        "choice": {
          "type": "string",
          "enum": [
            "atomic",
            "layered",
            "feature-first",
            "follow"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "atomic",
                  "layered",
                  "feature-first",
                  "follow"
                ]
              },
              "label": {
                "type": "string"
              },
              "folders": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "label",
              "folders"
            ]
          }
        }
      },
      "required": [
        "recommended",
        "choice",
        "reasons",
        "options"
      ]
    },
    "design_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "audit_id": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "accessibility",
              "consistency",
              "states",
              "platform",
              "localization",
              "ux"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "change": {
            "type": "string"
          },
          "why": {
            "type": "string"
          },
          "guideline": {
            "type": "string"
          },
          "choice": {
            "type": "string",
            "enum": [
              "keep",
              "apply"
            ]
          }
        },
        "required": [
          "id",
          "category",
          "severity",
          "title",
          "evidence",
          "change",
          "why",
          "guideline",
          "choice"
        ],
        "additionalProperties": false
      }
    },
    "breakpoints": {
      "type": "array",
      "description": "Web platforms only: the widths the build adapts at, min-width ascending. source 'project' = the project's own breakpoints; 'design' = mobile-first at the design's frame widths.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^.+$"
          },
          "min_width": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "enum": [
              "project",
              "design"
            ]
          }
        },
        "required": [
          "name",
          "min_width",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "update": {
      "type": "object",
      "properties": {
        "from_plan": {
          "type": "string"
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unchanged": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "from_plan",
        "changed",
        "added",
        "removed",
        "unchanged"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "approved",
    "approved_by",
    "platform",
    "items",
    "recommendations",
    "strings",
    "dependency_changes"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "platform": {
        "enum": [
          "web-react",
          "web-html"
        ]
      }
    },
    "required": [
      "platform"
    ]
  },
  "then": {
    "required": [
      "breakpoints"
    ]
  }
}
