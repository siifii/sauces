{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sauces verify summary (.sauces/verify/summary.json)",
  "type": "object",
  "properties": {
    "version": {"type": "integer", "enum": [1]},
    "platform": {"type": "string", "enum": ["flutter", "ios-swiftui", "android-compose", "kmp-cmp", "react-native", "web-react", "web-html"]},
    "threshold": {"type": "number", "minimum": 0, "maximum": 100},
    "threshold_source": {"type": "string", "enum": ["default", "config"], "description": "default = 90; config = .sauces/config.json fidelity_threshold."},
    "lite": {"type": "boolean", "description": "true when verify ran in a lite cook run (.sauces/lite): no determinism pass, one fix round, no pseudo-locale pass."},
    "renderer": {"type": "string", "description": "How screens were rendered, e.g. 'flutter test (test/sauces/)' or 'manual checklist'."},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*(@[0-9]+)?--[a-z0-9][a-z0-9_-]*$", "description": "<screen>--<state>; web: <screen>@<width>--<state>"},
          "screen": {"type": "string"},
          "state": {"type": "string"},
          "reference": {"type": "string"},
          "rendered": {"type": "boolean"},
          "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "passed": {"type": "boolean"},
          "iterations": {"type": "integer", "minimum": 0, "maximum": 3},
          "scores": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 100}, "description": "Score of each iteration, in order."},
          "rtl_issues": {"type": "array", "items": {"type": "string"}},
          "pseudo_issues": {"type": "array", "items": {"type": "string"}, "description": "Optional pseudo-locale pass (references/pseudo-locale.md): hard-coded or clipped text, overflow. Not scored."},
          "deviations": {"type": "array", "items": {"type": "string"}, "description": "suggestion_ids from .sauces/deviations.json for this screen state."},
          "remaining": {"type": "array", "items": {"type": "string"}, "description": "Differences left as they are, each with its reason."},
          "nondeterministic": {"type": "boolean", "description": "True when two renders of the same code scored more than 0.5 apart (R4)."}
        },
        "required": ["id", "screen", "state", "reference", "rendered", "score", "passed", "iterations", "scores", "rtl_issues", "deviations", "remaining"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "platform", "threshold", "renderer", "results"],
  "additionalProperties": false
}
